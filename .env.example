# ==============================================================================
# AUTOBOX74 - ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ (.env.example)
# ==============================================================================
# Скопируйте этот файл в .env.local и укажите ваши реальные значения:
# cp .env.example .env.local
# ВНИМАНИЕ: Никогда не коммитьте файл .env.local с реальными ключами в Git!

# ------------------------------------------------------------------------------
# 1. AI & OPENROUTER API (Для работы AI-консультанта)
# ------------------------------------------------------------------------------
# Получите ключ на https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="sk-or-v1-ваш_ключ_здесь"

# Опционально: дополнительные модели через запятую
# OPENROUTER_EXTRA_MODELS=""

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE (База данных, сессии чата и лиды)
# ------------------------------------------------------------------------------
# URL вашего проекта Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://ваш-проект.supabase.co"

# Публичный Anon ключ Supabase (Settings -> API -> Project API keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY="ваш_anon_key_здесь"

# Сервисный ключ Service Role (для защищенных серверных операций в API роутах)
SUPABASE_SERVICE_ROLE_KEY="ваш_service_role_key_здесь"

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT (Мгновенные уведомления мастеру о новых заявках)
# ------------------------------------------------------------------------------
# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=""

# ID чата мастера, группы или канала (@userinfobot для получения своего id)
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 4. SMTP / EMAIL NOTIFICATIONS (Резервное архивирование заявок на почту)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="info@autobox74.ru"
SMTP_PASS=""

# ------------------------------------------------------------------------------
# 5. AI CHAT SECURITY & ANTI-SPAM (Защита от накрутки токенов и атак)
# ------------------------------------------------------------------------------
# Кулдаун между отправкой сообщений (сек)
CHAT_COOLDOWN_SECONDS=5

# Максимальная длина одного сообщения клиента (символов)
CHAT_MAX_MESSAGE_LENGTH=600

# Общий лимит вызовов платных моделей в день на весь сервис (Circuit Breaker)
CHAT_DAILY_PAID_LIMIT=100

# Лимит уникальных сессий с платной моделью на один IP в сутки (далее fallback на openrouter/free)
CHAT_PAID_SESSIONS_PER_DAY=2

# Максимум запросов к AI-чату в минуту с одного IP
CHAT_IP_MAX_REQUESTS_PER_MINUTE=6

# Максимум запросов к AI-чату в час с одного IP
CHAT_IP_MAX_REQUESTS_PER_HOUR=40
